params {
    input_manifest = "${projectDir}/config/inputs.json"
    outdir = "${projectDir}/results/nextflow_regions"
    padding = 10000
    context_gene = "MYT1"
}

process {
    executor = 'local'
    cpus = 1
    memory = '1 GB'
    maxForks = 1
    errorStrategy = 'terminate'
    cache = 'deep'
    shell = ['/bin/bash', '-euo', 'pipefail']
}

executor {
    queueSize = 1
}

report {
    enabled = true
    file = "${params.outdir}/execution/report.html"
    overwrite = false
}

timeline {
    enabled = true
    file = "${params.outdir}/execution/timeline.html"
    overwrite = false
}

trace {
    enabled = true
    file = "${params.outdir}/execution/trace.tsv"
    overwrite = false
    fields = 'task_id,hash,name,status,exit,realtime,%cpu,peak_rss,read_bytes,write_bytes'
}
